{
  "name": "yeahhub-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "pnpm -r exec rm -rf node_modules dist",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
